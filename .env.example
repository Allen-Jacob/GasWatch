# General
APP_NAME=GasWatch
TZ=America/Toronto
LOG_LEVEL=INFO
DATA_PROVIDER=gasquebec
DATABASE_PATH=/app/data/gaswatch.db
GASQUEBEC_BASE_URL=https://www.gasquebec.ca
PROVIDER_TIMEOUT_SECONDS=15

# Emplacement simple. Remplacez ces exemples par vos coordonnees dans votre .env prive.
HOME_LATITUDE=46.8139
HOME_LONGITUDE=-71.2080
SEARCH_RADIUS_KM=15

# Pour plusieurs zones, activez plutot les lignes suivantes.
# LOCATIONS=HOME,WORK
# LOCATION_HOME_NAME=Maison
# LOCATION_HOME_LATITUDE=46.8139
# LOCATION_HOME_LONGITUDE=-71.2080
# LOCATION_HOME_RADIUS_KM=15
# LOCATION_WORK_NAME=Travail
# LOCATION_WORK_LATITUDE=46.8000
# LOCATION_WORK_LONGITUDE=-71.2000
# LOCATION_WORK_RADIUS_KM=10

# Vehicules. Les valeurs sont des exemples seulement.
VEHICLES=ASCENT
VEHICLE_ASCENT_NAME=Subaru Ascent
VEHICLE_ASCENT_FUEL=REGULAR
VEHICLE_ASCENT_CONSUMPTION=11.5
VEHICLE_ASCENT_TANK_CAPACITY=73
VEHICLE_ASCENT_AVERAGE_FILL_LITERS=50
# VEHICLE_ASCENT_TANK_LEVEL_PERCENT=50
# VEHICLE_ASCENT_DAILY_DISTANCE_KM=35
VEHICLE_ASCENT_MINIMUM_RESERVE_PERCENT=20

# REGULAR, PREMIUM ou DIESEL (utilise lorsqu'aucun VEHICLES n'est defini)
FUEL_TYPE=REGULAR

# Preferences
PREFERRED_STATIONS=Costco,Shell,Petro-Canada
PREFERRED_ONLY=false
PREFERRED_PRICE_TOLERANCE_CENTS=2
FAVORITE_STATION_IDS=
MAX_DETOUR_KM=8
MIN_NET_SAVINGS=2.00

# Collecte, historique et recommandations
PRICE_CHECK_INTERVAL_MINUTES=60
MAX_PRICE_AGE_MINUTES=180
HISTORY_DAYS=30
MINIMUM_HISTORY_DAYS=3
TARGET_PRICE_PERCENTILE=25
TARGET_PRICE_MODE=AUTO
# MANUAL_TARGET_PRICE_CENTS=159.9
GOOD_PRICE_THRESHOLD_CENTS=5
HIGH_PRICE_THRESHOLD_CENTS=5
VERY_HIGH_PRICE_THRESHOLD_CENTS=10

# Rapports et alertes
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=07:00
WEEKLY_SUMMARY_ENABLED=true
# 0=lundi, 6=dimanche
WEEKLY_SUMMARY_DAY=6
WEEKLY_SUMMARY_TIME=18:00
PRICE_ALERTS_ENABLED=true
ALERT_COOLDOWN_HOURS=12
ALERT_MIN_PRICE_DROP_CENTS=3

# ntfy. Aucun token n'est journalise.
NTFY_ENABLED=false
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=gaswatch
NTFY_TOKEN=

# Interface Web legere. Par defaut, Compose l'expose seulement sur la machine hote.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
